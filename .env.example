# cp .env.example .env  and edit. Every setting is optional.

T2I_DEFAULT_MODEL=flux2-klein-4b
# Load the model at startup instead of on the first request (recommended on a dedicated VM).
T2I_PRELOAD_MODEL=true
# Set true if VRAM is tight (slower).
T2I_CPU_OFFLOAD=false

# Result files older than this are deleted (0 = keep forever).
T2I_RETENTION_DAYS=30
T2I_MAX_QUEUE_SIZE=32
T2I_LOG_LEVEL=INFO

# Only for gated Hugging Face repos (not needed for flux2-klein-4b):
# HF_TOKEN=
# Air-gapped / pre-provisioned weights: mount them and forbid Hub access.
# HF_HUB_OFFLINE=1
